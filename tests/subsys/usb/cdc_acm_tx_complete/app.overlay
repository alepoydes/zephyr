// SPDX-License-Identifier: Apache-2.0
/delete-node/ &zephyr_udc0;
/ {
	zephyr_uhc0: uhc-vrt {
		compatible = "zephyr,uhc-virtual";
		zephyr_udc0: udc-vrt {
			compatible = "zephyr,udc-virtual";
			num-bidir-endpoints = <8>;
			maximum-speed = "full-speed";
			test_uart: cdc-acm {
				compatible = "zephyr,cdc-acm-uart";
			};
		};
	};
};
